---
import Base from './Base.astro';

interface Props {
  title: string;
  date: Date;
  description?: string;
  type?: 'note' | 'image' | 'video';
  image?: string;
  slug: string;
}

const { title, date, description, type = 'note', image, slug } = Astro.props;
const iso = date.toISOString().slice(0, 10);
// DD.MM.YYYY — matches the ledger.
const [_y, _m, _d] = iso.split('-');
const formatted = `${_d}.${_m}.${_y}`;
const objectLabel = { note: 'Note', image: 'Image', video: 'Video' }[type];

const url = `https://workspace.sh/devlog/${slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  ...(description && { description }),
  datePublished: date.toISOString(),
  dateModified: date.toISOString(),
  inLanguage: 'en-GB',
  url,
  mainEntityOfPage: url,
  ...(image && { image: new URL(image, 'https://workspace.sh').href }),
  author: { '@id': 'https://workspace.sh/#website' },
  publisher: { '@id': 'https://workspace.sh/#website' },
  isPartOf: { '@id': 'https://workspace.sh/devlog/#blog' },
};
---
<Base
  title={`${title} — Workspace`}
  description={description}
  image={image}
  ogType="article"
  published={date}
  jsonLd={jsonLd}
>
  <article class="post">
    <header class="post-header">
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={iso}>{formatted}</time>
        <span>{objectLabel}</span>
      </div>
    </header>
    <div class="post-body">
      <slot />
    </div>
  </article>
  <nav class="nav">
    <a href="/devlog/">← Development Log</a>
    <a href="/">Home</a>
  </nav>
</Base>
